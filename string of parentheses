
def is_balanced(text):
    stack = []
    pairs = {')': '(', ']': '[', '}': '{'}

    for char in text:
        if char in "([{":
            stack.append(char)
        elif char in ")]}":
            if not stack or stack.pop() != pairs[char]:
                return False

    return len(stack) == 0


text = input("Enter parentheses: ")

if is_balanced(text):
    print("Balanced")
else:
    print("Not balanced")
